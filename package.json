{
  "name": "proxima",
  "private": true,
  "version": "1.2.0",
  "scripts": {
    "version:sync": "node scripts/sync-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "build": "npm run version:sync && npm --prefix backend run build && npm --prefix frontend run build",
    "start": "npx pm2 start deploy/pm2.config.js",
    "start:backend": "node backend/dist/index.js",
    "start:frontend": "npm --prefix frontend start",
    "start:native": "npx pm2 start deploy/pm2.config.js"
  },
  "dependencies": {
    "express-rate-limit": "^8.5.2",
    "puppeteer-core": "^23.11.1"
  }
}
